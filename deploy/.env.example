# Where the InsiderTrack API is. Inside its Compose stack: http://tailscale:8003
INSIDERTRACK_URL=http://localhost:8013
# stdio (local subprocess) or streamable-http (network)
MCP_TRANSPORT=stdio
MCP_PORT=8100
# Bearer tokens accepted over HTTP: name:token pairs, comma-separated.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKENS=
# The one write tool (watchlist_add) exists only when this is 1 AND both
# watchlist values are set. They are the owner's own watchlist identity on
# the site (the token the browser holds, or a fresh one from Recover).
MCP_ALLOW_WRITES=0
INSIDERTRACK_WATCHLIST_EMAIL=
INSIDERTRACK_WATCHLIST_TOKEN=
